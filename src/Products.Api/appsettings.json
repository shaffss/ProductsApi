{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF loguje każde zapytanie na Information - koszt tylko w wariantach EF (Dapper nie loguje), przekłamałby benchmarki
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      // szczegóły nawiązywania połączenia na Information zasłaniały w logu wpisy konsumenta zdarzeń
      "StackExchange.Redis": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Wariant dostępu do danych: Orm = EfCore | Dapper, Database = SqlServer | Postgres
  "Persistence": {
    "Orm": "EfCore",
    "Database": "Postgres"
  },
  // Schemat przy starcie: None (już jest, np. po dotnet ef database update), Migrations (migracje EF)
  // albo Scripts (skrypty db/<baza>/Create, bez EF) - ten sam wynik, bazę można przełączać między nimi
  "Database": {
    "Schema": "None"
  },
  // Redis jako cache-aside dla GET /api/products/{id}; Enabled = false np. w benchmarkach bazy
  "Cache": {
    "Enabled": true,
    "ProductTtl": "00:05:00"
  },
  // Zdarzenia ProductPriceChanged: wysyłka z outboxa + konsument; BootstrapServers w konfiguracji środowiska
  "Kafka": {
    "Enabled": true,
    "ConsumerGroup": "products-api",
    "TopicPartitions": 3,
    "OutboxBatchSize": 100,
    "OutboxPollInterval": "00:00:01",
    // błędy samej wiadomości (np. za duża) - po tylu próbach dead-letter w outboxie
    "OutboxMaxAttempts": 10,
    // obsługa zdarzenia przez konsumenta - po tylu próbach zdarzenie pominięte (log Error)
    "ConsumerMaxAttempts": 5
  },
  // Usuwanie starych danych technicznych (co Interval, paczkami po BatchSize)
  "Retention": {
    "Enabled": true,
    "Interval": "01:00:00",
    "BatchSize": 1000,
    "OutboxMessages": "7.00:00:00",
    "ProcessedEvents": "7.00:00:00",
    "IdempotencyKeys": "1.00:00:00"
  }
}
