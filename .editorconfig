# Styl kodu - wspólny dla IDE i dotnet format (sprawdzany w CI)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml,html,css,js}]
indent_size = 2

# Windows PowerShell 5.1 czyta skrypty bez BOM w kodowaniu ANSI (polskie znaki)
[*.ps1]
charset = utf-8-bom

# cmd.exe z samymi LF potrafi źle czytać pliki wsadowe (jak w .gitattributes)
[*.cmd]
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# Analizatory: AnalysisLevel=latest-recommended (Directory.Build.props), ostrzeżenia są błędami.
# Wyjątki poniżej - każdy z uzasadnieniem.

# Kod generowany przez dotnet ef migrations add - nie edytujemy ręcznie
[src/Products.Migrations.*/Migrations/*.cs]
generated_code = true

[tests/**.cs]
# nazwy testów w stylu Metoda_scenariusz_oczekiwanie
dotnet_diagnostic.CA1707.severity = none
# DisposeAsync z IAsyncLifetime - klasy testów nie mają finalizatorów
dotnet_diagnostic.CA1816.severity = none
