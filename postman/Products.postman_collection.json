{
  "info": {
    "_postman_id": "5b0f3c1e-7a2d-4c1b-9e3f-2a6d8c4b1f70",
    "name": "Products API",
    "description": "Kolekcja do weryfikacji zadania. Środowiska (folder postman/environments) wskazują 4 warianty API z docker-compose (8081-8084) albo API uruchomione lokalnie (5032).\n\nFolder **1. Scenariusz z zadania** uruchom po kolei (Run folder) - każde żądanie ma testy. Folder **2. Walidacja i błędy** pokazuje odpowiedzi 400/404. Folder **3. Idempotencja, współbieżność, health** (też po kolei): Idempotency-Key przy tworzeniu, ETag/If-Match przy zmianie ceny, /health/live i /health/ready. Folder **4. Lista (usuwanie wyłączone)**: stronicowanie skip/take; DELETE zwraca 405, bo usuwanie produktów jest wyłączone.\n\nGrid z produktami (frontend): adres API w przeglądarce, np. http://localhost:8081/\n\nZdarzenie z Kafki po zmianie ceny widać w logu kontenera wariantu, np.:\n`docker logs api-efcore-postgres | findstr \"Product price changed\"`\nŚlad żądania przez outbox i Kafkę do konsumenta: Aspire Dashboard http://localhost:18888",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "productId", "value": "" },
    { "key": "missingId", "value": "00000000-0000-0000-0000-00000000dead" },
    { "key": "idempotencyKey", "value": "" },
    { "key": "idempotentProductId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Scenariusz z zadania",
      "description": "Przykładowa weryfikacja z zadania: utworzenie produktu, odczyt z bazy i z cache, zmiana ceny, unieważnienie cache, zdarzenie w Kafce.",
      "item": [
        {
          "name": "1.1 Stan aplikacji",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const health = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Healthy', () => pm.expect(health.status).to.eql('Healthy'));",
                  "pm.test('Wariant: ' + health.variant, () => pm.expect(health.variant).to.be.a('string'));",
                  "pm.test('Baza, Redis i Kafka sprawdzone', () => pm.expect(health.checks).to.have.all.keys('database', 'redis', 'kafka'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Stan aplikacji, działający wariant (ORM + baza) i stan zależności."
          }
        },
        {
          "name": "1.2 Utwórz produkt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Nagłówek Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/products/' + product.id));",
                  "pm.test('Dane produktu', () => {",
                  "    pm.expect(product.name).to.eql('Czujnik temperatury');",
                  "    pm.expect(product.price).to.eql(149.99);",
                  "    pm.expect(product.currency).to.eql('PLN');",
                  "    pm.expect(product.updatedAtUtc).to.match(/Z$/);",
                  "});",
                  "pm.collectionVariables.set('productId', product.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Czujnik temperatury\",\n  \"price\": 149.99,\n  \"currency\": \"PLN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "description": "Id zapisywane w zmiennej kolekcji productId - używają go kolejne żądania."
          }
        },
        {
          "name": "1.3 Pobierz produkt - z bazy (MISS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: MISS - odczyt z bazy, zapis do Redisa', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));",
                  "pm.test('Ten sam produkt', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('productId')));",
                  "pm.test('ETag - wersja produktu', () => pm.expect(pm.response.headers.get('ETag')).to.eql('\"1\"'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] },
            "description": "Brak w cache: produkt z bazy, zapisany w Redisie pod kluczem product:{id} z TTL 5 min.\nPodgląd: docker exec redis redis-cli GET product:{id}"
          }
        },
        {
          "name": "1.4 Pobierz produkt ponownie - z cache (HIT)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["// zapis do Redisa jest asynchroniczny (nie opóźnia odpowiedzi) - chwila zapasu", "setTimeout(() => {}, 300);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: HIT - odpowiedź z Redisa, bez zapytania do bazy', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));",
                  "pm.test('Cena 149.99', () => pm.expect(pm.response.json().price).to.eql(149.99));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          }
        },
        {
          "name": "1.5 Zmień cenę",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Nowa cena w odpowiedzi', () => {",
                  "    pm.expect(product.price).to.eql(129.99);",
                  "    pm.expect(product.currency).to.eql('PLN');",
                  "    pm.expect(product.message).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 129.99,\n  \"currency\": \"PLN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}", "price"]
            },
            "description": "Zapis w bazie (z historią i zdarzeniem w outboxie) -> usunięcie product:{id} z Redisa -> ProductPriceChanged do Kafki.\nPo chwili w logu wariantu: Product price changed: productId=..., oldPrice=149.99, newPrice=129.99, currency=PLN"
          }
        },
        {
          "name": "1.6 Pobierz po zmianie - cache unieważniony (MISS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: MISS - wpis usunięty po zmianie ceny', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));",
                  "pm.test('Nowa cena z bazy', () => pm.expect(pm.response.json().price).to.eql(129.99));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          }
        },
        {
          "name": "1.7 Zmień cenę - bez zmian",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Komunikat: nic nie zapisano', () => pm.expect(product.message).to.include('unchanged'));",
                  "pm.test('Produkt bez zmian', () => pm.expect(product.price).to.eql(129.99));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 129.99,\n  \"currency\": \"pln\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}", "price"]
            },
            "description": "Ta sama cena i waluta (kod waluty bez rozróżniania wielkości liter): bez zapisu, bez historii i bez zdarzenia - odpowiedź z polem message."
          }
        }
      ]
    },
    {
