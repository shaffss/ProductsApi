    {
      "name": "3. Idempotencja, współbieżność, health",
      "description": "Uruchom po kolei (Run folder). Idempotency-Key: ponowione utworzenie nie tworzy duplikatu. If-Match: zmiana ceny tylko dla wersji z ETag (optimistic concurrency).",
      "item": [
        {
          "name": "3.1 Żywotność (live)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Bez sprawdzania zależności', () => pm.expect(pm.response.json().checks).to.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] },
            "description": "Czy proces odpowiada - awaria bazy nie powoduje restartu instancji (livenessProbe)."
          }
        },
        {
          "name": "3.2 Gotowość (ready)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Baza, Redis i Kafka sprawdzone', () => pm.expect(pm.response.json().checks).to.have.all.keys('database', 'redis', 'kafka'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] },
            "description": "Czy instancja może obsługiwać ruch: baza wymagana (503), Redis i Kafka opcjonalne (Degraded)."
          }
        },
        {
          "name": "3.3 Utwórz z Idempotency-Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["// nowy klucz na każde uruchomienie folderu", "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Pierwsze żądanie - bez Idempotent-Replayed', () => pm.expect(pm.response.headers.has('Idempotent-Replayed')).to.be.false);",
                  "pm.collectionVariables.set('idempotentProductId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "\"{{idempotencyKey}}\"" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Czujnik CO2\",\n  \"price\": 299,\n  \"currency\": \"PLN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "description": "Klucz (np. UUID) nadaje klient; ważny 24 h."
          }
        },
        {
          "name": "3.4 Ponów z tym samym kluczem",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created - jak za pierwszym razem', () => pm.response.to.have.status(201));",
                  "pm.test('Idempotent-Replayed: true', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('Ten sam produkt - bez duplikatu', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('idempotentProductId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "\"{{idempotencyKey}}\"" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Czujnik CO2\",\n  \"price\": 299.00,\n  \"currency\": \"pln\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "description": "Np. ponowienie po utracie odpowiedzi. Ta sama treść inaczej zapisana (299.00, pln) to to samo żądanie."
          }
        },
        {
          "name": "3.5 Ten sam klucz, inna treść (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Content', () => pm.response.to.have.status(422));",
                  "pm.test('ProblemDetails', () => pm.expect(pm.response.json().title).to.eql('Idempotency key reused'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "\"{{idempotencyKey}}\"" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Czujnik CO2\",\n  \"price\": 199,\n  \"currency\": \"PLN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        },
        {
          "name": "3.6 Zmień cenę z If-Match (aktualna wersja)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Nowa cena', () => pm.expect(pm.response.json().price).to.eql(279));",
                  "pm.test('ETag - nowa wersja', () => pm.expect(pm.response.headers.get('ETag')).to.eql('\"2\"'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "If-Match", "value": "\"1\"" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 279,\n  \"currency\": \"PLN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{idempotentProductId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{idempotentProductId}}", "price"]
            },
            "description": "If-Match z ETag odczytanym przez GET (nowy produkt ma wersję 1)."
          }
        },
        {
          "name": "3.7 Zmień cenę z nieaktualnym If-Match (412)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('412 Precondition Failed', () => pm.response.to.have.status(412));",
                  "pm.test('Aktualna wersja w ETag', () => pm.expect(pm.response.headers.get('ETag')).to.eql('\"2\"'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "If-Match", "value": "\"1\"" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 259,\n  \"currency\": \"PLN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{idempotentProductId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{idempotentProductId}}", "price"]
            },
            "description": "Drugi klient z wersją sprzed zmiany - produkt zmienił się w międzyczasie, nic nie zapisano."
          }
        }
      ]
    },
    {
      "name": "4. Lista (usuwanie wyłączone)",
      "item": [
        {
          "name": "4.1 Lista - pierwsza strona",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const page = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Stronicowanie skip/take', () => pm.expect([page.skip, page.take]).to.eql([0, 5]));",
                  "pm.test('Najwyżej take produktów, total - wszystkie', () => {",
                  "    pm.expect(page.items.length).to.be.at.most(5);",
                  "    pm.expect(page.total).to.be.at.least(page.items.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?skip=0&take=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [{ "key": "skip", "value": "0" }, { "key": "take", "value": "5" }]
            },
            "description": "Od najnowszych. skip - ile pominąć, take - rozmiar strony (1-100, domyślnie 20), total - liczba wszystkich produktów."
          }
        },
        {
          "name": "4.2 Lista - niepoprawne stronicowanie (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Błędy skip i take', () => pm.expect(Object.keys(pm.response.json().errors).sort()).to.eql(['skip', 'take']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?skip=-1&take=101",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [{ "key": "skip", "value": "-1" }, { "key": "take", "value": "101" }]
            }
          }
        },
        {
          "name": "4.3 Usuwanie wyłączone (405)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 Method Not Allowed', () => pm.response.to.have.status(405));",
                  "pm.test('Allow bez DELETE', () => pm.expect(pm.response.headers.get('Allow')).to.not.include('DELETE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{missingId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{missingId}}"] },
            "description": "Usuwanie produktów jest wyłączone (decyzja biznesowa) - API nie ma endpointu DELETE."
          }
        }
      ]
    }
  ]
}
